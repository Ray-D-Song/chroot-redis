# Exact Redis Open Source package version from the official Redis APT
# repository for Debian 12 (bookworm). Upgrade deliberately by changing this
# file before creating a new release tag.
REDIS_PACKAGE_VERSION=6:8.10.0-1rl2~bookworm1
DEBIAN_SUITE=bookworm
DEBIAN_MIRROR=http://deb.debian.org/debian
REDIS_APT_REPOSITORY=https://packages.redis.io/deb
REDIS_APT_KEY=https://packages.redis.io/gpg
